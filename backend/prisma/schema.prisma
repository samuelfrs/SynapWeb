generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas  = ["scraping"]
}

model ScrapeJob {
  id           String      @id @default(uuid())
  url          String
  mode         ScrapeMode  @default(SCRAPE)
  status       JobStatus   @default(PENDING)
  format       ExportType  @default(MARKDOWN)

  contentMd    String?     @db.Text
  contentJson  Json?
  metadata     Json?
  error        String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  chatMessages ChatMessage[]

  @@map("scrape_jobs")
  @@schema("scraping")
}

model ChatMessage {
  id          String     @id @default(uuid())
  jobId       String
  job         ScrapeJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  role        String
  content     String     @db.Text
  createdAt   DateTime   @default(now())

  @@map("chat_messages")
  @@schema("scraping")
}

enum ScrapeMode {
  SCRAPE
  CRAWL
  EXTRACT

  @@schema("scraping")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@schema("scraping")
}

enum ExportType {
  MARKDOWN
  JSON

  @@schema("scraping")
}
